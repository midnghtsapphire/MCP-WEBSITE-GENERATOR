import { McpServer, StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk';
export function setupMCP() {
  const server = new McpServer({
    name: 'mct-website-generator',
    version: '1.0.0'
  });
  server.start(new StreamableHTTPServerTransport({ port: 4000 }));
}
### File: src/mct/tools.ts
import { McpServer } from '@modelcontextprotocol/sdk';
import { generateWebsite } from '../services/websiteService';
export function registerTools(server: McpServer) {
  server.registerTool('generateWebsite', {
    title: 'Generate Website',
    description: 'Generates a new website with specified content',
    inputSchema: { content: 'string' },
    outputSchema: { websiteUrl: 'string' }
  }, async ({ content }) => {
    const websiteUrl = await generateWebsite(content);
    return { websiteUrl };
  });
}
### File: src/services/websiteService.ts
import { Website } from '../db/schema';
export async function getWebsites(req, res) {
  const websites = await Website.find();
  res.json(websites);
}
export async function createWebsite(req, res) {
  const newWebsite = new Website(req.body);
  await newWebsite.save();
  res.status(201).json(newWebsite);
}
export async function updateWebsite(req, res) {
  const updatedWebsite = await Website.findByIdAndUpdate(req.params.id, req.body, { new: true });
  res.json(updatedWebsite);
}
export async function generateWebsite(content: string): Promise<string> {
  const newWebsite = new Website({ content });
  await newWebsite.save();
  return `http://localhost:3000/websites/${newWebsite.id}`;
}